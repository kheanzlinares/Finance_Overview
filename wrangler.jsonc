{
  // Cloudflare Worker: serves the built web app (./dist) and the sync API (/api/*).
  // Deploy guide: see "Host it on Cloudflare" in README.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-overview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_EMAILS": "kheanzlinares@icloud.com\nKheanzlinares@icloud.com"
  },
  // The database is created automatically on the first deploy
  "d1_databases": [{ "binding": "DB" }],
  // Keep variables set in the dashboard (e.g. ALLOWED_EMAILS) when deploying
  "keep_vars": true
}
